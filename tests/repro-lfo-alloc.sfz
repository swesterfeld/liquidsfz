// Reproduce issue #56, F10: LFOMod copies allocate in LFOGen::update_ccs().
// Requires Clang 21+ with RTSan and a running JACK server.
// Build from a clean checkout:
//   CXX=clang++-21 CXXFLAGS='-O1 -g' ./autogen.sh --without-lv2 --enable-rtsan
//   make -j4 -C lib && make -j4 -C src
// Run:
//   RTSAN_OPTIONS=fast_unwind_on_fatal=true ./src/liquidsfz tests/repro-lfo-alloc.sfz
// Enter: noteon 0 60 100
// Then enter: cc 0 1 127
// Expected: no RTSan errors. Before the fix, note-on reports malloc in
// LFOGen::update_ccs(); :halt_on_error=false also exposes the CC-update error.

<region>
sample=*sine
key=60
lfo1_freq=1
lfo2_freq=5
lfo2_pitch=100
lfo1_freq_lfo2_oncc1=2
